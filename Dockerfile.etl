FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# One lightweight Python image serves both ETL and read-only analytics.
COPY scripts/import_flights.py /app/scripts/import_flights.py
COPY scripts/run_analytics.py /app/scripts/run_analytics.py
COPY scripts/check_analytics.py /app/scripts/check_analytics.py
COPY database/queries/ /app/database/queries/
CMD ["python", "scripts/import_flights.py"]
